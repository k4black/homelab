  timemachine:
    image: mbentley/timemachine:smb-20261001  # pinned: the rolling `smb` tag re-pulls daily
    container_name: timemachine
    hostname: timemachine
    environment:
      TZ: {{ timezone }}
      TM_USERNAME: timemachine
      TM_GROUPNAME: timemachine
      PASSWORD: timemachine
      TM_UID: 1000
      TM_GID: 1000
      CUSTOM_SMB_CONF: false
      CUSTOM_USER: false
      EXTERNAL_CONF: ""
      HIDE_SHARES: "no"
      MIMIC_MODEL: "TimeCapsule8,119"
      SMB_PORT: 445
      SET_PERMISSIONS: "false"
      SMB_INHERIT_PERMISSIONS: "no"
      SMB_NFS_ACES: "yes"
      SMB_METADATA: "stream"
      SMB_VFS_OBJECTS: "acl_xattr fruit streams_xattr"
      VOLUME_SIZE_LIMIT: "0"  # unlimited
      DEBUG_LEVEL: 3
    volumes:
        # On the storage disk (containers_setup_make_dirs creates it). A missing
        # bind source would be auto-created on the SD card.
        - /mnt/storage/backups/timemachine:/opt/timemachine
        - timemachine-var-lib-samba:/var/lib/samba
        - timemachine-var-cache-samba:/var/cache/samba
        - timemachine-run-samba:/run/samba
    ulimits:
      nofile:
        soft: 65536
        hard: 65536
    ports:
      - "137:137/udp"
      - "138:138/udp"
      - "139:139"
      - "445:445"
{#    network_mode: host#}
    labels:
      - "homepage.group={{ homelab_host }}: Storage"
      - homepage.name=Time Machine
      - homepage.icon=apple
    restart: unless-stopped

  ### Media ###
  # Direct-play media server for LAN clients (iOS/Apple TV/Mac). Mounts the
  # media subset of the storage pool read-only so the UI can't delete source files.
  # Library is split into /media/movies (Radarr) and /media/tv (Sonarr). No HW
  # transcoding configured — Pi 5's VideoCore VII V4L2 path is still maturing in
  # 2025-2026, and modern clients direct-play H.264/HEVC fine. To enable HW
  # transcode later: pass `--device /dev/dri` and configure Jellyfin > Playback >
  # VAAPI in the admin UI.
  jellyfin:
    # TODO: 12.1 needs a /config backup, plugin removal and a full library rescan.
    image: jellyfin/jellyfin:10.11.11
    container_name: jellyfin
    # Jellyfin reads the server name from the container hostname on first start —
    # without this it shows a container-hash string in the UI.
    hostname: {{ device_name }}
    user: "1000:1000"
    environment:
      TZ: {{ timezone }}
      # JELLYFIN_PublishedServerUrl intentionally unset — single value would only
      # match one of LAN-IP / Tailscale / pi5.local; leave it unset for clients
      # to use the request's own origin.
    ports:
      - "127.0.0.1:8096:8096"  # the playbook drives the API from the host
      - "7359:7359/udp"   # LAN auto-discovery (Swiftfin/Findroid find the server)
    # The SSO plugin must resolve auth.vps.{{ domain }} (LAN view via Pi-hole).
    dns:
      - {{ pi5_docker_network_pihole_ip }}
    volumes:
      - {{ containers_setup_data_dir }}/jellyfin/config:/config
      - {{ containers_setup_data_dir }}/jellyfin/cache:/cache
      - /mnt/storage/media:/media:ro
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.jellyfin.rule=Host(`jellyfin.pi5.{{ domain }}`)"
      - "traefik.http.routers.jellyfin.entrypoints=websecure"
      - "traefik.http.routers.jellyfin.tls=true"
      - "traefik.http.routers.jellyfin.tls.certresolver=cf"
      - "traefik.http.services.jellyfin.loadbalancer.server.port=8096"
      - "homepage.group={{ homelab_host }}: Media"
      - homepage.name=Jellyfin
      - homepage.icon=jellyfin
      - homepage.href=https://jellyfin.pi5.{{ domain }}
      - homepage.statusStyle=basic
      - homepage.instance.{{ homelab_host }}.ping=http://jellyfin:8096
    healthcheck:
      test: ["CMD", "curl", "-fsS", "http://localhost:8096/health"]
      interval: 30s
      timeout: 10s
      retries: 3
    restart: unless-stopped

  # Indexer aggregator. Replaces Jackett; Radarr/Sonarr pull indexers from here.
  # Auth = External (set by the playbook): LAN/tailnet gating, no app login.
  prowlarr:
    image: linuxserver/prowlarr:2.6.5
    container_name: prowlarr
    environment:
      PUID: 1000
      PGID: 1000
      TZ: {{ timezone }}
    ports:
      - "127.0.0.1:9696:9696"  # the playbook drives the API from the host
    volumes:
      - {{ containers_setup_data_dir }}/prowlarr/config:/config
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.prowlarr.rule=Host(`prowlarr.pi5.{{ domain }}`)"
      - "traefik.http.routers.prowlarr.entrypoints=websecure"
      - "traefik.http.routers.prowlarr.tls=true"
      - "traefik.http.routers.prowlarr.tls.certresolver=cf"
      - "traefik.http.services.prowlarr.loadbalancer.server.port=9696"
      - "homepage.group={{ homelab_host }}: Media"
      - homepage.name=Prowlarr
      - homepage.icon=prowlarr
      - homepage.href=https://prowlarr.pi5.{{ domain }}
      - homepage.statusStyle=basic
      - homepage.instance.{{ homelab_host }}.ping=http://prowlarr:9696
    healthcheck:
      test: ["CMD", "curl", "-fsS", "http://localhost:9696/ping"]
      interval: 30s
      timeout: 10s
      retries: 3
    restart: unless-stopped

  # Movie automation. TRaSH-canonical single /data mount — both /data/torrents
  # (download dir, populated by Transmission) and /data/media (library) live
  # under one bind mount so hardlinks (atomic, no copy) stay within one mounted
  # filesystem from the container's perspective. Path translation against
  # Transmission's /downloads view happens via Radarr's Remote Path Mapping
  # configured in tasks/configure_arr_stack.yml.
  radarr:
    image: linuxserver/radarr:6.4.4
    container_name: radarr
    environment:
      PUID: 1000
      PGID: 1000
      TZ: {{ timezone }}
    ports:
      - "127.0.0.1:7878:7878"  # the playbook drives the API from the host
    volumes:
      - {{ containers_setup_data_dir }}/radarr/config:/config
      - /mnt/storage:/data
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.radarr.rule=Host(`radarr.pi5.{{ domain }}`)"
      - "traefik.http.routers.radarr.entrypoints=websecure"
      - "traefik.http.routers.radarr.tls=true"
      - "traefik.http.routers.radarr.tls.certresolver=cf"
      - "traefik.http.services.radarr.loadbalancer.server.port=7878"
      - "homepage.group={{ homelab_host }}: Media"
      - homepage.name=Radarr
      - homepage.icon=radarr
      - homepage.href=https://radarr.pi5.{{ domain }}
      - homepage.statusStyle=basic
      - homepage.instance.{{ homelab_host }}.ping=http://radarr:7878
    healthcheck:
      test: ["CMD", "curl", "-fsS", "http://localhost:7878/ping"]
      interval: 30s
      timeout: 10s
      retries: 3
    restart: unless-stopped

  # CloudFlare-challenge solver for Prowlarr. Many public trackers (1337x,
  # KickAssTorrents, sometimes LimeTorrents/EZTV) sit behind CloudFlare —
  # they fail Prowlarr's connectivity test otherwise. Wired into Prowlarr's
  # "Indexer Proxy" with a tag; indexers tagged the same way route their
  # requests through this container. Note: FS runs a headless Chromium
  # (200-400 MB RAM) — pay the cost only when CF-protected indexers are wanted.
  flaresolverr:
    image: ghcr.io/flaresolverr/flaresolverr:v3.5.2
    container_name: flaresolverr
    environment:
      LOG_LEVEL: info
      TZ: {{ timezone }}
    ports:
      - "127.0.0.1:8191:8191"  # the playbook drives the API from the host
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.flaresolverr.rule=Host(`flaresolverr.pi5.{{ domain }}`)"
      - "traefik.http.routers.flaresolverr.entrypoints=websecure"
      - "traefik.http.routers.flaresolverr.tls=true"
      - "traefik.http.routers.flaresolverr.tls.certresolver=cf"
      - "traefik.http.services.flaresolverr.loadbalancer.server.port=8191"
      - "homepage.group={{ homelab_host }}: Media"
      - homepage.name=FlareSolverr
      - homepage.icon=flaresolverr
      - homepage.href=https://flaresolverr.pi5.{{ domain }}
      - homepage.statusStyle=basic
      - homepage.instance.{{ homelab_host }}.ping=http://flaresolverr:8191
    healthcheck:
      test: ["CMD", "curl", "-fsS", "http://localhost:8191/health"]
      interval: 30s
      timeout: 10s
      retries: 3
    restart: unless-stopped

  # TV automation. Same canonical /data mount as Radarr — see comment above.
  sonarr:
    image: linuxserver/sonarr:4.0.20
    container_name: sonarr
    environment:
      PUID: 1000
      PGID: 1000
      TZ: {{ timezone }}
    ports:
      - "127.0.0.1:8989:8989"  # the playbook drives the API from the host
    volumes:
      - {{ containers_setup_data_dir }}/sonarr/config:/config
      - /mnt/storage:/data
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.sonarr.rule=Host(`sonarr.pi5.{{ domain }}`)"
      - "traefik.http.routers.sonarr.entrypoints=websecure"
      - "traefik.http.routers.sonarr.tls=true"
      - "traefik.http.routers.sonarr.tls.certresolver=cf"
      - "traefik.http.services.sonarr.loadbalancer.server.port=8989"
      - "homepage.group={{ homelab_host }}: Media"
      - homepage.name=Sonarr
      - homepage.icon=sonarr
      - homepage.href=https://sonarr.pi5.{{ domain }}
      - homepage.statusStyle=basic
      - homepage.instance.{{ homelab_host }}.ping=http://sonarr:8989
    healthcheck:
      test: ["CMD", "curl", "-fsS", "http://localhost:8989/ping"]
      interval: 30s
      timeout: 10s
      retries: 3
    restart: unless-stopped

  ### AI ###
  hermes:
    image: nousresearch/hermes-agent:v2026.9.24
    container_name: hermes
    environment:
      TZ: {{ timezone }}
      # Remap the image's internal uid/gid 10000 -> 1000 so files written to the
      # /opt/data bind mount stay owned by {{ username }} (1000) on the host.
      HERMES_UID: "1000"
      HERMES_GID: "1000"
      # Web dashboard, reached through Traefik (hermes.pi5.{{ domain }}). Since
      # hermes-agent v2026.9.24 (June-2026 hardening, PR #50476) a non-loopback
      # bind ALWAYS requires an auth provider — HERMES_DASHBOARD_INSECURE is a
      # warned no-op and the dashboard fails closed without basic auth. Kept:
      # the bot has shell access, so the dashboard keeps its own login.
      # TODO: limit egress (the container can reach the LAN and the tailnet).
      HERMES_DASHBOARD: "true"
      HERMES_DASHBOARD_HOST: 0.0.0.0
      HERMES_DASHBOARD_PORT: "9119"
      HERMES_DASHBOARD_BASIC_AUTH_USERNAME: "{{ hermes_dashboard_username }}"
      HERMES_DASHBOARD_BASIC_AUTH_PASSWORD: ${HERMES_DASHBOARD_PASSWORD}
      HERMES_DASHBOARD_BASIC_AUTH_SECRET: ${HERMES_DASHBOARD_AUTH_SECRET}
      # LLM provider (model/provider/base_url are in config.yaml).
      OPENROUTER_API_KEY: ${OPENROUTER_API_KEY}
      # Telegram gateway — token present => the gateway enables the bot. The
      # allowlist restricts who may talk to it (numeric Telegram user IDs).
      TELEGRAM_BOT_TOKEN: ${TELEGRAM_BOT_TOKEN}
      TELEGRAM_ALLOWED_USERS: ${TELEGRAM_ALLOWED_USERS}
      # The anki-connect skill reads this to reach the sibling `anki` container
      # over the bridge (the skill defaults to localhost, falls back to anki).
      ANKI_CONNECT_URL: http://anki:8765
    volumes:
      # HERMES_HOME — holds config.yaml, session history, vector memory, learned
      # skills, and logs. config.yaml is rendered here before first start.
      - {{ containers_setup_data_dir }}/hermes:/opt/data
      # Skills repo (k4black/.agents), read-only: Hermes cannot rewrite its own
      # skills. A host cron pulls it daily; Hermes sends suggested changes as
      # Telegram diffs instead of pushing.
      - {{ containers_setup_data_dir }}/hermes/.agents:/opt/data/.agents:ro
    command: ["gateway", "run"]
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.hermes.rule=Host(`hermes.pi5.{{ domain }}`)"
      - "traefik.http.routers.hermes.entrypoints=websecure"
      - "traefik.http.routers.hermes.tls=true"
      - "traefik.http.routers.hermes.tls.certresolver=cf"
      - "traefik.http.services.hermes.loadbalancer.server.port=9119"
      - "homepage.group={{ homelab_host }}: Services"
      - homepage.name=Hermes
      - homepage.icon=mdi-robot-happy
      - homepage.href=https://hermes.pi5.{{ domain }}
      - homepage.statusStyle=basic
      - homepage.instance.{{ homelab_host }}.ping=http://hermes:9119
    healthcheck:
      # /api/status is the dashboard's public status endpoint (no auth).
      test: ["CMD", "curl", "-fsS", "http://localhost:9119/api/status"]
      interval: 30s
      timeout: 10s
      retries: 3
    restart: unless-stopped

  # Headless Anki + AnkiConnect (no GUI). Built locally from the upstream
  # ThisIsntTheWay/headless-anki clone with a patched, arch-aware Dockerfile
  # (files/pi5/anki.Dockerfile -> Dockerfile.pi5 in the clone): official
  # anki-26.05-linux-aarch64 on debian:13-slim (glibc 2.41). The published
  # kaiimehra arm64 image can't run here (built on glibc 2.35 < Anki's 2.36).
  # Exposes AnkiConnect on :8765 for the agent's anki-connect skill (Hermes
  # reaches it at http://anki:8765 — see ANKI_CONNECT_URL on the hermes service).
  # Named volume seeds /data from the image's baked profile; QT_QPA_PLATFORM=
  # offscreen keeps it headless (set "vnc" + publish 5900 for a one-time GUI
  # AnkiWeb login).
  anki:
    build:
      context: {{ anki_build_dir }}
      dockerfile: Dockerfile.pi5
    image: headless-anki-pi5:local
    container_name: anki
    environment:
      TZ: {{ timezone }}
      # Set AnkiConnect's webCorsOriginList to ["*"] so cross-origin callers work.
      ANKICONNECT_WILDCARD_ORIGIN: "1"
      # Headless. AnkiWeb auth + collection were seeded from the Mac's profile
      # (syncKey injected into prefs21.db + collection.anki2 copied into the
      # anki-data volume), so no GUI login is needed — it auto-syncs on start.
      # For a future GUI session set this to "vnc" and re-publish 5900.
      QT_QPA_PLATFORM: offscreen
    volumes:
      - anki-data:/data
      - anki-export:/export
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.anki.rule=Host(`anki.pi5.{{ domain }}`)"
      - "traefik.http.routers.anki.entrypoints=websecure"
      - "traefik.http.routers.anki.tls=true"
      - "traefik.http.routers.anki.tls.certresolver=cf"
      - "traefik.http.services.anki.loadbalancer.server.port=8765"
      - "homepage.group={{ homelab_host }}: Services"
      - homepage.name=Anki
      - homepage.icon=anki
      - homepage.href=https://anki.pi5.{{ domain }}
      - homepage.statusStyle=basic
      - homepage.instance.{{ homelab_host }}.ping=http://anki:8765
    healthcheck:
      # AnkiConnect is POST-only — a bare GET returns non-2xx. Probe the real API.
      test: ["CMD-SHELL", "curl -fsS http://localhost:8765 -X POST -d '{\"action\":\"version\",\"version\":6}' | grep -q result"]
      interval: 30s
      timeout: 10s
      retries: 3
    restart: unless-stopped

  ### Files ###
  # Auth is disabled (`--noauth`) — relies on VPN/Tailscale/LAN restriction for
  # access control. `--noauth` only takes effect during quickSetup() on an empty
  # /database; to flip it later, wipe /database/filebrowser.db on the host and
  # recreate the container.
  filebrowser:
    # TODO: final release (upstream archived 2026-09); move to the maintained fork.
    image: filebrowser/filebrowser:v2.63.23
    container_name: filebrowser
    user: "1000:1000"
    command: ["--noauth"]
    volumes:
      - {{ containers_setup_data_dir }}/filebrowser/config:/config
      - {{ containers_setup_data_dir }}/filebrowser/database:/database
      - /mnt/storage:/srv/storage
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.filebrowser.rule=Host(`filebrowser.pi5.{{ domain }}`)"
      - "traefik.http.routers.filebrowser.entrypoints=websecure"
      - "traefik.http.routers.filebrowser.tls=true"
      - "traefik.http.routers.filebrowser.tls.certresolver=cf"
      - "traefik.http.services.filebrowser.loadbalancer.server.port=80"
      - "homepage.group={{ homelab_host }}: Storage"
      - homepage.name=Filebrowser
      - homepage.icon=filebrowser
      - homepage.href=https://filebrowser.pi5.{{ domain }}
      - homepage.statusStyle=basic
      - homepage.instance.{{ homelab_host }}.ping=http://filebrowser:80
    healthcheck:
      # /healthcheck.sh is shipped in the image — wraps `wget --spider /health`
      # and reads port/address from /config/settings.json. Overriding only to
      # widen the image's default 5s interval (which spams logs every 5s).
      test: ["CMD", "/healthcheck.sh"]
      interval: 30s
      timeout: 10s
      retries: 3
    restart: unless-stopped

  ### Downloads ###
  # TRaSH-canonical single /data mount, identical to Radarr/Sonarr. Transmission
  # writes completed torrents into /data/torrents/{movies,tv} (the per-torrent
  # download-dir is set by Radarr/Sonarr when they add the torrent). Incomplete-
  # dir is disabled in settings.json — partial files get .part suffix in place.
  # Hardlinks from /data/torrents/* into /data/media/* are atomic because every
  # container sees them as a single mount.
  transmission:
    image: linuxserver/transmission:4.1.3
    container_name: transmission
    environment:
      PUID: 1000
      PGID: 1000
      TZ: {{ timezone }}
      # LSIO clobbers settings.json's umask from this on every start. 002 →
      # group-writable files, required for Radarr/Sonarr (same PGID 1000) to
      # hardlink/delete Transmission's downloads.
      UMASK: "002"
      # Transmission 4.x still IP-filters even when rpc-whitelist-enabled is
      # false (undocumented anti-DNS-rebinding behaviour, log line "IP not
      # whitelisted"). Explicitly allow loopback + docker bridges + LAN here so
      # Radarr/Sonarr (sibling containers on the bridge) can reach the RPC.
      WHITELIST: "127.0.0.1,10.*.*.*,172.16.*.*,172.17.*.*,172.18.*.*,192.168.*.*"
      # Disable the Host-header rebinding check too — RPC is LAN/VPN-gated and
      # UFW blocks :9091 from the public internet, so this is acceptable.
      HOST_WHITELIST: "*"
    ports:
      - "51413:51413"
      - "51413:51413/udp"
    volumes:
      - {{ containers_setup_configs_dir }}/transmission-config:/config
      - /mnt/storage:/data
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.transmission.rule=Host(`transmission.pi5.{{ domain }}`)"
      - "traefik.http.routers.transmission.entrypoints=websecure"
      - "traefik.http.routers.transmission.tls=true"
      - "traefik.http.routers.transmission.tls.certresolver=cf"
      - "traefik.http.services.transmission.loadbalancer.server.port=9091"
      - "homepage.group={{ homelab_host }}: Media"
      - homepage.name=Transmission
      - homepage.icon=transmission
      - homepage.href=https://transmission.pi5.{{ domain }}
      - homepage.statusStyle=basic
      - homepage.instance.{{ homelab_host }}.ping=http://transmission:9091
      - homepage.instance.{{ homelab_host }}.widget.type=transmission
      - homepage.instance.{{ homelab_host }}.widget.url=http://transmission:9091
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:9091"]
      interval: 30s
      timeout: 10s
      retries: 3
    restart: unless-stopped

  ### Metrics ###
  glances:
    image: nicolargo/glances:4.5.7-full
    container_name: glances
    pid: host
    environment:
      TZ: {{ timezone }}
      # -w web/API mode; -t 10 = refresh every 10s instead of default 3s (homepage polls ~15s anyway);
      # disable plugins we never query (cuts per-tick work substantially on a Pi 5).
      GLANCES_OPT: "-w -t 10 --disable-plugin sensors,smart,raid,hddtemp,wifi,gpu,ports,irq,folders,amps"
      DOCKER_HOST: tcp://docker-socket-proxy:2375
    depends_on:
      - docker-socket-proxy
    volumes:
      - /:/rootfs:ro
      - /etc/os-release:/etc/os-release:ro
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.glances.rule=Host(`glances.pi5.{{ domain }}`)"
      - "traefik.http.routers.glances.entrypoints=websecure"
      - "traefik.http.routers.glances.tls=true"
      - "traefik.http.routers.glances.tls.certresolver=cf"
      - "traefik.http.services.glances.loadbalancer.server.port=61208"
      - "homepage.group={{ homelab_host }}: Monitoring"
      - homepage.name=Glances
      - homepage.icon=glances
      - homepage.href=https://glances.pi5.{{ domain }}
      - homepage.statusStyle=basic
      - homepage.instance.{{ homelab_host }}.ping=http://glances:61208
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:61208/api/4/status"]
      interval: 30s
      timeout: 10s
      retries: 3
    restart: unless-stopped

  netdata:
    image: netdata/netdata:v2.12.0
    container_name: netdata
    hostname: {{ device_name }}
    pid: host
    network_mode: host
    cap_add:
      - SYS_PTRACE
      - SYS_ADMIN
    security_opt:
      - apparmor:unconfined
    environment:
      - DISABLE_TELEMETRY=1
    volumes:
      - {{ containers_setup_configs_dir }}/netdata-config/netdata.conf:/etc/netdata/netdata.conf:ro
      - {{ containers_setup_configs_dir }}/netdata-config/stream.conf:/etc/netdata/stream.conf:ro
      - {{ containers_setup_configs_dir }}/netdata-config/go.d/pihole.conf:/etc/netdata/go.d/pihole.conf:ro
      - netdata-lib:/var/lib/netdata
      - netdata-cache:/var/cache/netdata
      - /:/host/root:ro,rslave
      - /etc/passwd:/host/etc/passwd:ro
      - /etc/group:/host/etc/group:ro
      - /etc/localtime:/etc/localtime:ro
      - /proc:/host/proc:ro
      - /sys:/host/sys:ro
      - /etc/os-release:/host/etc/os-release:ro
      - /var/log:/host/var/log:ro
      - /var/run/docker.sock:/var/run/docker.sock:ro
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.netdata.rule=Host(`netdata.pi5.{{ domain }}`)"
      - "traefik.http.routers.netdata.entrypoints=websecure"
      - "traefik.http.routers.netdata.tls=true"
      - "traefik.http.routers.netdata.tls.certresolver=cf"
      # Host network: no bridge IP, so point Traefik at the host via the gateway.
      - "traefik.http.services.netdata.loadbalancer.server.url=http://{{ pi5_docker_network_gateway }}:19999"
      - "homepage.group={{ homelab_host }}: Monitoring"
      - homepage.name=Netdata
      - homepage.icon=netdata
      - homepage.href=https://netdata.pi5.{{ domain }}/v3#
      - homepage.statusStyle=basic
      - homepage.instance.{{ homelab_host }}.ping=http://host.docker.internal:19999
      - homepage.instance.{{ homelab_host }}.widget.type=netdata
      - homepage.instance.{{ homelab_host }}.widget.url=http://host.docker.internal:19999
    restart: unless-stopped

  tailscale:
    image: {{ tailscale_image }}
    container_name: tailscale
    hostname: pi5
    network_mode: host
    cap_add:
      - NET_ADMIN
      - NET_RAW
    environment:
      # Key is minted per deploy by tasks/tailscale_mint_key.yml (one-off, tagged)
      # and consumed on first login; empty once the node is authenticated.
      TS_AUTHKEY: "{{ tailscale_node_authkey | default('') }}"
      # TS_AUTH_ONCE: state is persisted in TS_STATE_DIR (mounted volume), so log in
      # only when the container is not authenticated yet — the default (false) forces
      # a fresh login on every start.
      TS_AUTH_ONCE: "true"
      # Kernel networking: userspace mode (the image default) gives the host no
      # tailscale0 interface, so nothing outside the tailnet can reach host
      # services and host-to-host tailnet traffic is impossible. Needs
      # /dev/net/tun + NET_ADMIN, both already set below/above.
      TS_USERSPACE: "false"
      TS_STATE_DIR: /var/lib/tailscale
      # Default is /tmp/tailscaled.sock symlinked into /var/run/tailscale — the
      # symlink target isn't shareable across containers, so put the real socket
      # in the shared volume directly. Traefik's `ts` resolver expects this path.
      TS_SOCKET: /var/run/tailscale/tailscaled.sock
      # --advertise-tags makes the node tag-owned (ACL tag {{ tailscale_tag }}).
      TS_EXTRA_ARGS: "{{ tailscale_extra_args }} --advertise-tags={{ tailscale_tag }}"
      TS_ENABLE_HEALTH_CHECK: true
    volumes:
      - {{ containers_setup_data_dir }}/tailscale:/var/lib/tailscale
      - /dev/net/tun:/dev/net/tun
      # Expose tailscaled.sock to traefik (which uses it for the `ts` cert resolver).
      - tailscale-socket:/var/run/tailscale
    labels:
      - "homepage.group={{ homelab_host }}: Networking"
      - homepage.name=Tailscale
      - homepage.icon=tailscale
    healthcheck:
      test: [ "CMD", "wget", "--spider", "-q", "http://127.0.0.1:9002/healthz" ]
    restart: unless-stopped
