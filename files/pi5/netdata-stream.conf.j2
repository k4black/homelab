# {{ ansible_managed }}

{% if vps_tailscale_ipv4 %}
# Stream to VPS (active-active parent)
[stream]
    enabled = yes
    destination = {{ vps_tailscale_ipv4 }}:19999
    api key = {{ netdata_stream_api_key }}
    send charts matching = *
{% else %}
# vps_tailscale_ipv4 (BWS) is empty: the pi5 does not stream until the vps
# rejoins the tailnet. Accepting the vps stream below needs no address.
{% endif %}

# Accept streams from VPS. The api key is the credential; ufw limits :19999 to
# the LAN and the tailnet.
[{{ netdata_stream_api_key }}]
    enabled = yes
    allow from = *
    db = dbengine
    enable replication = yes
    replication period = 14d
