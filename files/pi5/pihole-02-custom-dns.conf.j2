# LAN view: every <host>.{{ domain }} (apex + subdomains) resolves to THIS host,
# so clients on the LAN and the local containers always hit the local Traefik.
# It serves the local services and forwards the other hosts over the tailnet
# (files/shared/traefik-forward-routes.yml.j2). Outside the LAN the public
# Cloudflare records (vps cloudflare-ddns) win.
{% for h in homelab_hosts %}
address=/{{ h.name }}.{{ domain }}/{{ local_ipv4 }}
{% endfor %}
