http:
  middlewares:
    # Authelia forward auth. Attached per router (`middlewares=authelia@file`)
    # to every service under {{ domain }} except Authelia itself and the
    # forward routes' targets that carry their own login (none today).
    authelia:
      forwardAuth:
        address: http://authelia:9091/api/authz/forward-auth
        trustForwardHeader: true
        authResponseHeaders:
          - Remote-User
          - Remote-Groups
          - Remote-Email
          - Remote-Name
  # The fragment fills routers/services/serversTransports (other hosts over the tailnet).
  routers:
{% include 'files/shared/traefik-forward-routes.yml.j2' %}

tls:
  stores:
    default:
      # Pre-fetched wildcard cert presented for any TLS handshake that doesn't
      # match a more specific certificate (e.g. routers pinned to the `lehttp`
      # or `ts` resolvers).
      defaultGeneratedCert:
        resolver: cf
        domain:
          main: "vps.{{ domain }}"
          sans:
            - "*.vps.{{ domain }}"
