# {{ ansible_managed }}

networks:
  default:
    driver: bridge
    ipam:
      config:
        - subnet: {{ vps_docker_network_subnet }}
          gateway: {{ vps_docker_network_gateway }}

volumes:
  netdata-lib:
  netdata-cache:
  # Shared between the tailscale daemon and traefik so traefik's `ts` cert
  # resolver can reach tailscaled.sock for the *.ts.net certificate.
  tailscale-socket:


services:
  ### Utils ###
  myspeed:
    image: germannewsmaker/myspeed:1.0.9
    container_name: myspeed
    ports:
      - "5216:5216"
    volumes:
      - {{ containers_setup_data_dir }}/myspeed:/myspeed/data
    restart: unless-stopped

  ## Networking ##
  duckdns:
    image: linuxserver/duckdns:latest
    container_name: duckdns
    environment:
      TZ: {{ timezone }}
      SUBDOMAINS: {{ vps_duckdns_subdomain }}
      TOKEN: ${DUCKDNS_TOKEN}
      LOG_FILE: true
    restart: unless-stopped

  cloudflare-ddns:
    image: favonia/cloudflare-ddns:1.17.1
    container_name: cloudflare-ddns
    environment:
      CF_API_TOKEN: ${CLOUDFLARE_API_TOKEN}
      DOMAINS: "vps.{{ domain }},*.vps.{{ domain }}"
      PROXIED: "false"
      IP4_PROVIDER: cloudflare.trace
      IP6_PROVIDER: none
    restart: unless-stopped

  # TODO: thing about unbound to resolve DNS and not send it to the google etc
  pihole:
    image: pihole/pihole:2026.09.0
    container_name: pihole
    environment:
      PIHOLE_UID: 1000
      PIHOLE_GID: 1000
      TZ: {{ timezone }}
      FTLCONF_webserver_api_password: ''  # no password
      FTLCONF_dns_upstreams: "1.1.1.1;8.8.8.8"
      FTLCONF_dns_listeningMode: "local"
      # Pi-hole v6 does NOT read /etc/dnsmasq.d unless this is set, so the
      # mounted 02-custom-dns.conf (cname entries) is ignored without it.
      # Only *.conf files are loaded.
      FTLCONF_misc_etc_dnsmasq_d: 'true'
      FTLCONF_LOCAL_IPV4: "{{ local_ipv4 }}"
    ports:
      - "53:53/tcp"
      - "53:53/udp"
      - "8053:80/tcp"  # custom port for web interface
    volumes:
      - {{ containers_setup_configs_dir }}/pihole/:/etc/pihole/:rw
      - {{ containers_setup_configs_dir }}/pihole-dnsmasq.d:/etc/dnsmasq.d/:rw
    networks:
      default:
        ipv4_address: {{ vps_docker_network_pihole_ip }}
    healthcheck:
      test: ["CMD", "dig", "+norecurse", "+retry=0", "@127.0.0.1", "pi.hole"]
      interval: 30s
      timeout: 10s
      retries: 3
    restart: unless-stopped

  traefik:
    image: traefik:v3.7.13
    container_name: traefik
    environment:
      # Used by the `cf` ACME resolver for DNS-01. Same token as cloudflare-ddns (from .env) —
      # already has Zone:DNS:Edit on the zone.
      CF_DNS_API_TOKEN: ${CLOUDFLARE_API_TOKEN}
    ports:
      - "80:80"
      - "443:443"
      - "8080:8080"  # optional dashboard
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
      - {{ containers_setup_configs_dir }}/traefik-config.yml:/etc/traefik/traefik.yml:ro
      - {{ containers_setup_configs_dir }}/traefik-dynamic.yml:/etc/traefik/dynamic.yml:ro
      - {{ containers_setup_data_dir }}/traefik-letsencrypt:/letsencrypt
      - tailscale-socket:/var/run/tailscale
    healthcheck:
      test: ["CMD", "traefik", "healthcheck", "--ping=true", "--ping.entrypoint=ping"]
      interval: 30s
      timeout: 10s
      retries: 3
    restart: unless-stopped

  ### Games ###
  foundryvtt:
    image: felddy/foundryvtt:14.368.0
    container_name: foundryvtt
    # Foundry binds its licence to the container hostname; without this Docker
    # assigns a random ID per recreate and licence verification fails.
    hostname: foundryvtt
    environment:
      PUID: 1000
      PGID: 1000
      TZ: {{ timezone }}
      FOUNDRY_MINIFY_STATIC_FILES: "true"
      FOUNDRY_COMPRESS_WEBSOCKET: "true"
      FOUNDRY_PROXY_SSL: "true"            # behind TLS-terminating proxy
      FOUNDRY_PROXY_PORT: 443              # external port the clients hit
      FOUNDRY_HOSTNAME: "foundry.{{ vps_duckdns_subdomain }}.duckdns.org"
      CONTAINER_PRESERVE_CONFIG: "true"
      FOUNDRY_USERNAME: ${FOUNDRY_USERNAME}
      FOUNDRY_PASSWORD: ${FOUNDRY_PASSWORD}
      FOUNDRY_ADMIN_KEY: ${FOUNDRY_ADMIN_KEY}
    volumes:
      - {{ containers_setup_data_dir }}/foundryvtt:/data
    labels:
      - traefik.enable=true
      # service (backend) → Foundry on :30000 inside the container
      - traefik.http.services.foundry.loadbalancer.server.port=30000
      # router → subdomain host
      - traefik.http.routers.foundry.rule=Host(`foundry.{{ vps_duckdns_subdomain }}.duckdns.org`)
      - traefik.http.routers.foundry.entrypoints=websecure
      - traefik.http.routers.foundry.tls=true
      - traefik.http.routers.foundry.tls.certresolver=lehttp
      - traefik.http.routers.foundry.service=foundry
    ports:
      - "30000:30000"
    healthcheck:
      test: ["CMD", "node", "-e",
        "const http=require('http');\
const req=http.request({host:'127.0.0.1',port:30000,path:'/',timeout:2000},res=>{process.exit(res.statusCode<500?0:1)});\
req.on('timeout',()=>{req.destroy();process.exit(1)});\
req.on('error',()=>process.exit(1));\
req.end();"]
      interval: 30s
      timeout: 10s
      retries: 10
      start_period: 120s
    restart: unless-stopped

  ### Files ###
  # Auth is disabled (`--noauth`) — relies on VPN/Tailscale for access control;
  # UFW already blocks :8181 from the public internet (not in open_ports list).
  # `--noauth` only takes effect during quickSetup() on an empty /database; to
  # flip it later, wipe /database/filebrowser.db on the host and recreate the
  # container.
  filebrowser:
    # TODO: final release (upstream archived 2026-09); move to the maintained fork.
    image: filebrowser/filebrowser:v2.63.23
    container_name: filebrowser
    user: "1000:1000"
    command: ["--noauth"]
    ports:
      - "8181:80"
    volumes:
      - {{ containers_setup_data_dir }}/filebrowser/config:/config
      - {{ containers_setup_data_dir }}/filebrowser/database:/database
      - {{ containers_setup_data_dir }}/downloads:/srv/downloads
      - {{ containers_setup_data_dir }}/foundryvtt:/srv/foundryvtt
    healthcheck:
      # /healthcheck.sh is shipped in the image — wraps `wget --spider /health`
      # and reads port/address from /config/settings.json. Overriding only to
      # widen the image's default 5s interval (which spams logs every 5s).
      test: ["CMD", "/healthcheck.sh"]
      interval: 30s
      timeout: 10s
      retries: 3
    restart: unless-stopped

  ### Downloads ###
  transmission:
    image: linuxserver/transmission:4.1.3
    container_name: transmission
    environment:
      PUID: 1000
      PGID: 1000
      TZ: {{ timezone }}
    ports:
      - "9091:9091"
      - "51413:51413"
      - "51413:51413/udp"
    volumes:
      - {{ containers_setup_configs_dir }}/transmission-config:/config
      - {{ containers_setup_data_dir }}/downloads:/downloads
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:9091"]
      interval: 30s
      timeout: 10s
      retries: 3
    restart: unless-stopped

  ### Metrics ###
  glances:
    image: nicolargo/glances:4.5.7-full
    container_name: glances
    pid: host
    environment:
      TZ: {{ timezone }}
      # -w web/API mode; -t 10 = refresh every 10s instead of default 3s (homepage polls ~15s anyway);
      # disable plugins we never query.
      GLANCES_OPT: "-w -t 10 --disable-plugin sensors,smart,raid,hddtemp,wifi,gpu,ports,irq,folders,amps"
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
      - /:/rootfs:ro
      - /etc/os-release:/etc/os-release:ro
    ports:
      - "61208:61208"
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:61208/api/4/status"]
      interval: 30s
      timeout: 10s
      retries: 3
    restart: unless-stopped

  netdata:
    image: netdata/netdata:v2.12.0
    container_name: netdata
    hostname: {{ device_name }}
    pid: host
    network_mode: host
    cap_add:
      - SYS_PTRACE
      - SYS_ADMIN
    security_opt:
      - apparmor:unconfined
    environment:
      - DISABLE_TELEMETRY=1
    volumes:
      - {{ containers_setup_configs_dir }}/netdata-config/netdata.conf:/etc/netdata/netdata.conf:ro
      - {{ containers_setup_configs_dir }}/netdata-config/stream.conf:/etc/netdata/stream.conf:ro
      - netdata-lib:/var/lib/netdata
      - netdata-cache:/var/cache/netdata
      - /:/host/root:ro,rslave
      - /etc/passwd:/host/etc/passwd:ro
      - /etc/group:/host/etc/group:ro
      - /etc/localtime:/etc/localtime:ro
      - /proc:/host/proc:ro
      - /sys:/host/sys:ro
      - /etc/os-release:/host/etc/os-release:ro
      - /var/log:/host/var/log:ro
      - /var/run/docker.sock:/var/run/docker.sock:ro
    restart: unless-stopped

  tailscale:
    image: {{ tailscale_image }}
    container_name: tailscale
    hostname: vps
    network_mode: host
    cap_add:
      - NET_ADMIN
      - NET_RAW
    environment:
      # Key is minted per deploy by tasks/tailscale_mint_key.yml (one-off, tagged)
      # and consumed on first login; empty once the node is authenticated.
      TS_AUTHKEY: "{{ tailscale_node_authkey | default('') }}"
      # TS_AUTH_ONCE: state is persisted in TS_STATE_DIR (mounted volume), so log in
      # only when the container is not authenticated yet — the default (false) forces
      # a fresh login on every start.
      TS_AUTH_ONCE: "true"
      # Kernel networking: userspace mode (the image default) gives the host no
      # tailscale0 interface, so nothing outside the tailnet can reach host
      # services and host-to-host tailnet traffic is impossible. Needs
      # /dev/net/tun + NET_ADMIN, both already set below/above.
      TS_USERSPACE: "false"
      TS_STATE_DIR: /var/lib/tailscale
      # Default is /tmp/tailscaled.sock symlinked into /var/run/tailscale — the
      # symlink target isn't shareable across containers, so put the real socket
      # in the shared volume directly. Traefik's `ts` resolver expects this path.
      TS_SOCKET: /var/run/tailscale/tailscaled.sock
      # --advertise-tags makes the node tag-owned (ACL tag {{ tailscale_tag }}).
      TS_EXTRA_ARGS: "{{ tailscale_extra_args }} --advertise-tags={{ tailscale_tag }}"
      TS_ENABLE_HEALTH_CHECK: true
    volumes:
      - {{ containers_setup_data_dir }}/tailscale:/var/lib/tailscale
      - /dev/net/tun:/dev/net/tun
      # Expose tailscaled.sock to traefik (which uses it for the `ts` cert resolver).
      - tailscale-socket:/var/run/tailscale
    healthcheck:
      test: [ "CMD", "wget", "--spider", "-q", "http://127.0.0.1:9002/healthz" ]
    restart: unless-stopped
