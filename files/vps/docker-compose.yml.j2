# {{ ansible_managed }}
# No published ports: every web UI is a Traefik router svc.vps.{{ domain }}
# behind Authelia (middlewares=authelia@file). Exceptions: traefik 80/443,
# pihole 53, transmission 51413, the docker socket proxy on the tailnet IP.

networks:
  default:
    driver: bridge
    ipam:
      config:
        - subnet: {{ vps_docker_network_subnet }}
          gateway: {{ vps_docker_network_gateway }}

volumes:
  netdata-lib:
  netdata-cache:
  # Shared between the tailscale daemon and traefik so traefik's `ts` cert
  # resolver can reach tailscaled.sock for the *.ts.net certificate.
  tailscale-socket:


services:
  ### Utils ###
  myspeed:
    image: germannewsmaker/myspeed:1.0.9
    container_name: myspeed
    volumes:
      - {{ containers_setup_data_dir }}/myspeed:/myspeed/data
    labels:
      - traefik.enable=true
      - traefik.http.services.myspeed.loadbalancer.server.port=5216
      - traefik.http.routers.myspeed.rule=Host(`myspeed.vps.{{ domain }}`)
      - traefik.http.routers.myspeed.entrypoints=websecure
      - traefik.http.routers.myspeed.tls.certresolver=cf
      - traefik.http.routers.myspeed.middlewares=authelia@file
      - "homepage.group=vps: Monitoring"
      - homepage.name=MySpeed
      - homepage.icon=myspeed
      - homepage.href=https://myspeed.vps.{{ domain }}
      - homepage.statusStyle=basic
      - homepage.instance.vps.ping=http://myspeed:5216
      - homepage.instance.vps.widget.type=myspeed
      - homepage.instance.vps.widget.url=http://myspeed:5216
    restart: unless-stopped

  ## Networking ##
  duckdns:
    image: linuxserver/duckdns:latest
    container_name: duckdns
    environment:
      TZ: {{ timezone }}
      SUBDOMAINS: {{ vps_duckdns_subdomain }}
      TOKEN: ${DUCKDNS_TOKEN}
      LOG_FILE: true
    labels:
      - "homepage.group=vps: Networking"
      - homepage.name=DuckDNS
      - homepage.icon=duckdns
    restart: unless-stopped

  # The vps is the public door: it publishes the A records of EVERY host in
  # homelab_hosts; the vps Traefik forwards the other hosts over the tailnet.
  cloudflare-ddns:
    image: favonia/cloudflare-ddns:1.17.1
    container_name: cloudflare-ddns
    environment:
      CF_API_TOKEN: ${CLOUDFLARE_API_TOKEN}
      DOMAINS: "{% for h in homelab_hosts %}{{ h.name }}.{{ domain }},*.{{ h.name }}.{{ domain }}{% if not loop.last %},{% endif %}{% endfor %}"
      PROXIED: "false"
      IP4_PROVIDER: cloudflare.trace
      IP6_PROVIDER: none
    labels:
      - "homepage.group=vps: Networking"
      - homepage.name=Cloudflare DDNS
      - homepage.icon=cloudflare
    restart: unless-stopped

  # TODO: thing about unbound to resolve DNS and not send it to the google etc
  pihole:
    image: pihole/pihole:2026.09.0
    container_name: pihole
    environment:
      PIHOLE_UID: 1000
      PIHOLE_GID: 1000
      TZ: {{ timezone }}
      FTLCONF_webserver_api_password: ''  # no password
      FTLCONF_dns_upstreams: "1.1.1.1;8.8.8.8"
      FTLCONF_dns_listeningMode: "local"
      # Pi-hole v6 does NOT read /etc/dnsmasq.d unless this is set, so the
      # mounted 02-custom-dns.conf (cname entries) is ignored without it.
      # Only *.conf files are loaded.
      FTLCONF_misc_etc_dnsmasq_d: 'true'
      FTLCONF_LOCAL_IPV4: "{{ local_ipv4 }}"
    # Bound to the host's own IP and loopback: the tailnet IP:53 belongs to
    # tailnet-dns (host network). Containers use the bridge IP directly.
    ports:
      - "127.0.0.1:53:53/tcp"
      - "127.0.0.1:53:53/udp"
{% if local_ipv4 != '127.0.0.1' %}
      - "{{ local_ipv4 }}:53:53/tcp"
      - "{{ local_ipv4 }}:53:53/udp"
{% endif %}
    volumes:
      - {{ containers_setup_configs_dir }}/pihole/:/etc/pihole/:rw
      - {{ containers_setup_configs_dir }}/pihole-dnsmasq.d:/etc/dnsmasq.d/:rw
    networks:
      default:
        ipv4_address: {{ vps_docker_network_pihole_ip }}
    labels:
      - traefik.enable=true
      - traefik.http.services.pihole.loadbalancer.server.port=80
      - traefik.http.routers.pihole.rule=Host(`pihole.vps.{{ domain }}`)
      - traefik.http.routers.pihole.entrypoints=websecure
      - traefik.http.routers.pihole.tls.certresolver=cf
      - traefik.http.routers.pihole.middlewares=authelia@file
      - "homepage.group=vps: Networking"
      - homepage.name=Pi-hole
      - homepage.icon=pi-hole
      - homepage.href=https://pihole.vps.{{ domain }}/admin
      - homepage.statusStyle=basic
      - homepage.instance.vps.ping=http://pihole:80
      - homepage.instance.vps.widget.type=pihole
      - homepage.instance.vps.widget.url=http://pihole:80
      - homepage.instance.vps.widget.version=6
      - homepage.instance.vps.widget.key=
    healthcheck:
      test: ["CMD", "dig", "+norecurse", "+retry=0", "@127.0.0.1", "pi.hole"]
      interval: 30s
      timeout: 10s
      retries: 3
    restart: unless-stopped

  # Tailnet view of the DNS: *.<host>.{{ domain }} -> that host's tailnet IP.
  # Listens on tailscale0 only (files/shared/tailnet-dns.conf.j2), so it needs the
  # interface up first. Tailscale split DNS for {{ domain }} points here.
  tailnet-dns:
    image: 4km3/dnsmasq:2.90-r3
    container_name: tailnet-dns
    network_mode: host
    cap_add:
      - NET_ADMIN
    volumes:
      - {{ containers_setup_configs_dir }}/tailnet-dns.conf:/etc/dnsmasq.conf:ro
    depends_on:
      tailscale:
        condition: service_healthy
    restart: unless-stopped

  # Read-only view of the docker API for traefik, homepage and glances (local)
  # and the other hosts' homepages (tailnet). Only netdata keeps the raw socket.
  docker-socket-proxy:
    image: tecnativa/docker-socket-proxy:v0.5.0
    container_name: docker-socket-proxy
    environment:
      CONTAINERS: 1
      NETWORKS: 1
      EVENTS: 1
      PING: 1
      VERSION: 1
      INFO: 1
      POST: 0
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
{% if vps_tailscale_ipv4 %}
    ports:
      - "{{ vps_tailscale_ipv4 }}:2375:2375"
    depends_on:
      tailscale:
        condition: service_healthy
{% endif %}
    restart: unless-stopped

  traefik:
    image: traefik:v3.7.13
    container_name: traefik
    environment:
      # Used by the `cf` ACME resolver for DNS-01. Same token as cloudflare-ddns (from .env) —
      # already has Zone:DNS:Edit on the zone.
      CF_DNS_API_TOKEN: ${CLOUDFLARE_API_TOKEN}
    ports:
      - "80:80"
      - "443:443"
    # netdata runs on the host network; its router points at host.docker.internal.
    extra_hosts:
      - "host.docker.internal:host-gateway"
    volumes:
      - {{ containers_setup_configs_dir }}/traefik-config.yml:/etc/traefik/traefik.yml:ro
      - {{ containers_setup_configs_dir }}/traefik-dynamic.yml:/etc/traefik/dynamic.yml:ro
      - {{ containers_setup_data_dir }}/traefik-letsencrypt:/letsencrypt
      - tailscale-socket:/var/run/tailscale
    labels:
      - traefik.enable=true
      - traefik.http.routers.traefik.rule=Host(`traefik.vps.{{ domain }}`)
      - traefik.http.routers.traefik.service=api@internal
      - traefik.http.routers.traefik.entrypoints=websecure
      - traefik.http.routers.traefik.tls.certresolver=cf
      - traefik.http.routers.traefik.middlewares=authelia@file
      - "homepage.group=vps: Networking"
      - homepage.name=Traefik
      - homepage.icon=traefik
      - homepage.href=https://traefik.vps.{{ domain }}
      - homepage.statusStyle=basic
      - homepage.instance.vps.ping=http://traefik:8082/ping
    depends_on:
      - docker-socket-proxy
    healthcheck:
      test: ["CMD", "traefik", "healthcheck", "--ping=true", "--ping.entrypoint=ping"]
      interval: 30s
      timeout: 10s
      retries: 3
    restart: unless-stopped

  ### Auth ###
  # The single login for the public door. configuration.yml + users_database.yml
  # are secret templates (0640); the sqlite db and the notification file live
  # in /data. The image ships its own HEALTHCHECK (/app/healthcheck.sh).
  authelia:
    image: authelia/authelia:4.39.28
    container_name: authelia
    environment:
      TZ: {{ timezone }}
    volumes:
      - {{ containers_setup_configs_dir }}/authelia:/config
      - {{ containers_setup_data_dir }}/authelia:/data
    labels:
      - traefik.enable=true
      - traefik.http.services.authelia.loadbalancer.server.port=9091
      - traefik.http.routers.authelia.rule=Host(`auth.vps.{{ domain }}`)
      - traefik.http.routers.authelia.entrypoints=websecure
      - traefik.http.routers.authelia.tls.certresolver=cf
      - "homepage.group=vps: Networking"
      - homepage.name=Authelia
      - homepage.icon=authelia
      - homepage.href=https://auth.vps.{{ domain }}
      - homepage.statusStyle=basic
      - homepage.instance.vps.ping=http://authelia:9091/api/health
    restart: unless-stopped

  ### Dashboard ###
  homepage:
    image: ghcr.io/gethomepage/homepage:v2.4.0
    container_name: homepage
    user: "1000:1000"
    environment:
      PUID: 1000
      PGID: 1000
      TZ: {{ timezone }}
      HOMEPAGE_ALLOWED_HOSTS: "vps.{{ domain }}"
    # Lets server-side widget calls reach host-network containers (netdata) via the bridge gateway.
    extra_hosts:
      - "host.docker.internal:host-gateway"
    # The local Pi-hole resolves the other hosts' service names (LAN view).
    dns:
      - {{ vps_docker_network_pihole_ip }}
    volumes:
      - {{ containers_setup_configs_dir }}/homepage-config:/app/config
    labels:
      - traefik.enable=true
      - traefik.http.services.homepage.loadbalancer.server.port=3000
      - traefik.http.routers.homepage.rule=Host(`vps.{{ domain }}`)
      - traefik.http.routers.homepage.entrypoints=websecure
      - traefik.http.routers.homepage.tls.certresolver=cf
      - traefik.http.routers.homepage.middlewares=authelia@file
    depends_on:
      - docker-socket-proxy
    restart: unless-stopped

  ### Games ###
  # Own login, own DuckDNS host (not under {{ domain }}): no Authelia.
  foundryvtt:
    image: felddy/foundryvtt:14.368.0
    container_name: foundryvtt
    # Foundry binds its licence to the container hostname; without this Docker
    # assigns a random ID per recreate and licence verification fails.
    hostname: foundryvtt
    environment:
      PUID: 1000
      PGID: 1000
      TZ: {{ timezone }}
      FOUNDRY_MINIFY_STATIC_FILES: "true"
      FOUNDRY_COMPRESS_WEBSOCKET: "true"
      FOUNDRY_PROXY_SSL: "true"            # behind TLS-terminating proxy
      FOUNDRY_PROXY_PORT: 443              # external port the clients hit
      FOUNDRY_HOSTNAME: "foundry.{{ vps_duckdns_subdomain }}.duckdns.org"
      CONTAINER_PRESERVE_CONFIG: "true"
      FOUNDRY_USERNAME: ${FOUNDRY_USERNAME}
      FOUNDRY_PASSWORD: ${FOUNDRY_PASSWORD}
      FOUNDRY_ADMIN_KEY: ${FOUNDRY_ADMIN_KEY}
    volumes:
      - {{ containers_setup_data_dir }}/foundryvtt:/data
    labels:
      - traefik.enable=true
      - traefik.http.services.foundry.loadbalancer.server.port=30000
      - traefik.http.routers.foundry.rule=Host(`foundry.{{ vps_duckdns_subdomain }}.duckdns.org`)
      - traefik.http.routers.foundry.entrypoints=websecure
      # HTTP-01: the DuckDNS name is not in the Cloudflare zone.
      - traefik.http.routers.foundry.tls.certresolver=lehttp
      - "homepage.group=vps: Services"
      - homepage.name=Foundry VTT
      - homepage.icon=foundry-vtt
      - homepage.href=https://foundry.{{ vps_duckdns_subdomain }}.duckdns.org
      - homepage.statusStyle=basic
      - homepage.instance.vps.ping=http://foundryvtt:30000
    healthcheck:
      test: ["CMD", "node", "-e",
        "const http=require('http');\
const req=http.request({host:'127.0.0.1',port:30000,path:'/',timeout:2000},res=>{process.exit(res.statusCode<500?0:1)});\
req.on('timeout',()=>{req.destroy();process.exit(1)});\
req.on('error',()=>process.exit(1));\
req.end();"]
      interval: 30s
      timeout: 10s
      retries: 10
      start_period: 120s
    restart: unless-stopped

  ### Files ###
  # `--noauth`: Authelia in front. It only takes effect during quickSetup() on
  # an empty /database; to flip it later, wipe /database/filebrowser.db on the
  # host and recreate the container.
  filebrowser:
    # TODO: final release (upstream archived 2026-09); move to the maintained fork.
    image: filebrowser/filebrowser:v2.63.23
    container_name: filebrowser
    user: "1000:1000"
    command: ["--noauth"]
    volumes:
      - {{ containers_setup_data_dir }}/filebrowser/config:/config
      - {{ containers_setup_data_dir }}/filebrowser/database:/database
      - {{ containers_setup_data_dir }}/downloads:/srv/downloads
      - {{ containers_setup_data_dir }}/foundryvtt:/srv/foundryvtt
    labels:
      - traefik.enable=true
      - traefik.http.services.filebrowser.loadbalancer.server.port=80
      - traefik.http.routers.filebrowser.rule=Host(`files.vps.{{ domain }}`)
      - traefik.http.routers.filebrowser.entrypoints=websecure
      - traefik.http.routers.filebrowser.tls.certresolver=cf
      - traefik.http.routers.filebrowser.middlewares=authelia@file
      - "homepage.group=vps: Storage"
      - homepage.name=Filebrowser
      - homepage.icon=filebrowser
      - homepage.href=https://files.vps.{{ domain }}
      - homepage.statusStyle=basic
      - homepage.instance.vps.ping=http://filebrowser:80
    healthcheck:
      # /healthcheck.sh is shipped in the image — wraps `wget --spider /health`
      # and reads port/address from /config/settings.json. Overriding only to
      # widen the image's default 5s interval (which spams logs every 5s).
      test: ["CMD", "/healthcheck.sh"]
      interval: 30s
      timeout: 10s
      retries: 3
    restart: unless-stopped

  ### Downloads ###
  transmission:
    image: linuxserver/transmission:4.1.3
    container_name: transmission
    environment:
      PUID: 1000
      PGID: 1000
      TZ: {{ timezone }}
    ports:
      - "51413:51413"
      - "51413:51413/udp"
    volumes:
      - {{ containers_setup_configs_dir }}/transmission-config:/config
      - {{ containers_setup_data_dir }}/downloads:/downloads
    labels:
      - traefik.enable=true
      - traefik.http.services.transmission.loadbalancer.server.port=9091
      - traefik.http.routers.transmission.rule=Host(`transmission.vps.{{ domain }}`)
      - traefik.http.routers.transmission.entrypoints=websecure
      - traefik.http.routers.transmission.tls.certresolver=cf
      - traefik.http.routers.transmission.middlewares=authelia@file
      - "homepage.group=vps: Media"
      - homepage.name=Transmission
      - homepage.icon=transmission
      - homepage.href=https://transmission.vps.{{ domain }}
      - homepage.statusStyle=basic
      - homepage.instance.vps.ping=http://transmission:9091
      - homepage.instance.vps.widget.type=transmission
      - homepage.instance.vps.widget.url=http://transmission:9091
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:9091"]
      interval: 30s
      timeout: 10s
      retries: 3
    restart: unless-stopped

  ### Metrics ###
  glances:
    image: nicolargo/glances:4.5.7-full
    container_name: glances
    pid: host
    environment:
      TZ: {{ timezone }}
      DOCKER_HOST: tcp://docker-socket-proxy:2375
      # -w web/API mode; -t 10 = refresh every 10s instead of default 3s (homepage polls ~15s anyway);
      # disable plugins we never query.
      GLANCES_OPT: "-w -t 10 --disable-plugin sensors,smart,raid,hddtemp,wifi,gpu,ports,irq,folders,amps"
    volumes:
      - /:/rootfs:ro
      - /etc/os-release:/etc/os-release:ro
    labels:
      - traefik.enable=true
      - traefik.http.services.glances.loadbalancer.server.port=61208
      - traefik.http.routers.glances.rule=Host(`glances.vps.{{ domain }}`)
      - traefik.http.routers.glances.entrypoints=websecure
      - traefik.http.routers.glances.tls.certresolver=cf
      - traefik.http.routers.glances.middlewares=authelia@file
      - "homepage.group=vps: Monitoring"
      - homepage.name=Glances
      - homepage.icon=glances
      - homepage.href=https://glances.vps.{{ domain }}
      - homepage.statusStyle=basic
      - homepage.instance.vps.ping=http://glances:61208
    depends_on:
      - docker-socket-proxy
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:61208/api/4/status"]
      interval: 30s
      timeout: 10s
      retries: 3
    restart: unless-stopped

  netdata:
    image: netdata/netdata:v2.12.0
    container_name: netdata
    hostname: {{ device_name }}
    pid: host
    network_mode: host
    cap_add:
      - SYS_PTRACE
      - SYS_ADMIN
    security_opt:
      - apparmor:unconfined
    environment:
      - DISABLE_TELEMETRY=1
    volumes:
      - {{ containers_setup_configs_dir }}/netdata-config/netdata.conf:/etc/netdata/netdata.conf:ro
      - {{ containers_setup_configs_dir }}/netdata-config/stream.conf:/etc/netdata/stream.conf:ro
      - netdata-lib:/var/lib/netdata
      - netdata-cache:/var/cache/netdata
      - /:/host/root:ro,rslave
      - /etc/passwd:/host/etc/passwd:ro
      - /etc/group:/host/etc/group:ro
      - /etc/localtime:/etc/localtime:ro
      - /proc:/host/proc:ro
      - /sys:/host/sys:ro
      - /etc/os-release:/host/etc/os-release:ro
      - /var/log:/host/var/log:ro
      - /var/run/docker.sock:/var/run/docker.sock:ro
    labels:
      - traefik.enable=true
      # Host network: no container IP for Traefik, so the backend URL is explicit.
      - traefik.http.services.netdata.loadbalancer.server.url=http://host.docker.internal:19999
      - traefik.http.routers.netdata.rule=Host(`netdata.vps.{{ domain }}`)
      - traefik.http.routers.netdata.entrypoints=websecure
      - traefik.http.routers.netdata.tls.certresolver=cf
      - traefik.http.routers.netdata.middlewares=authelia@file
      - "homepage.group=vps: Monitoring"
      - homepage.name=Netdata
      - homepage.icon=netdata
      - homepage.href=https://netdata.vps.{{ domain }}/v3#
      - homepage.statusStyle=basic
      - homepage.instance.vps.ping=http://host.docker.internal:19999
      - homepage.instance.vps.widget.type=netdata
      - homepage.instance.vps.widget.url=http://host.docker.internal:19999
    restart: unless-stopped

  tailscale:
    image: {{ tailscale_image }}
    container_name: tailscale
    hostname: vps
    network_mode: host
    cap_add:
      - NET_ADMIN
      - NET_RAW
    environment:
      # Key is minted per deploy by tasks/tailscale_mint_key.yml (one-off, tagged)
      # and consumed on first login; empty once the node is authenticated.
      TS_AUTHKEY: "{{ tailscale_node_authkey | default('') }}"
      # TS_AUTH_ONCE: state is persisted in TS_STATE_DIR (mounted volume), so log in
      # only when the container is not authenticated yet — the default (false) forces
      # a fresh login on every start.
      TS_AUTH_ONCE: "true"
      # Kernel networking: userspace mode (the image default) gives the host no
      # tailscale0 interface, so nothing outside the tailnet can reach host
      # services and host-to-host tailnet traffic is impossible. Needs
      # /dev/net/tun + NET_ADMIN, both already set below/above.
      TS_USERSPACE: "false"
      TS_STATE_DIR: /var/lib/tailscale
      # Default is /tmp/tailscaled.sock symlinked into /var/run/tailscale — the
      # symlink target isn't shareable across containers, so put the real socket
      # in the shared volume directly. Traefik's `ts` resolver expects this path.
      TS_SOCKET: /var/run/tailscale/tailscaled.sock
      # --advertise-tags makes the node tag-owned (ACL tag {{ tailscale_tag }}).
      TS_EXTRA_ARGS: "{{ tailscale_extra_args }} --advertise-tags={{ tailscale_tag }}"
      TS_ENABLE_HEALTH_CHECK: true
    volumes:
      - {{ containers_setup_data_dir }}/tailscale:/var/lib/tailscale
      - /dev/net/tun:/dev/net/tun
      # Expose tailscaled.sock to traefik (which uses it for the `ts` cert resolver).
      - tailscale-socket:/var/run/tailscale
    healthcheck:
      test: [ "CMD", "wget", "--spider", "-q", "http://127.0.0.1:9002/healthz" ]
    restart: unless-stopped
