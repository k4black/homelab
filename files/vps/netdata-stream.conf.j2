# {{ ansible_managed }}

# Stream to Pi5 (active-active parent)
[stream]
    enabled = yes
    destination = {{ pi5_tailscale_ipv4 }}:19999
    api key = {{ netdata_stream_api_key }}
    send charts matching = *

# Accept streams from Pi5
[{{ netdata_stream_api_key }}]
    enabled = yes
    allow from = {{ pi5_tailscale_ipv4 }}
    db = dbengine
    enable replication = yes
    replication period = 14d
